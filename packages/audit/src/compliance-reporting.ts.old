import { createHash } from 'crypto'
import { and, between, desc, eq, inArray, sql } from 'drizzle-orm'

import type { PostgresJsDatabase } from 'drizzle-orm/postgres-js'
import type { AuditEventStatus, PractitionerAuditAction } from './types.js'

/**
 * Filters for querying audit logs (Requirement 7.5)
 */
export interface AuditLogFilters {
	dateRange?: {
		start: string
		end: string
	}
	practitionerId?: string
	licenseNumber?: string
	actions?: PractitionerAuditAction[]
	status?: AuditEventStatus[]
	principalId?: string
	organizationId?: string
	jurisdiction?: string
	verificationProvider?: string
	limit?: number
	offset?: number
}

/**
 * Audit log entry with all fields for compliance reporting
 */
export interface AuditLogEntry {
	id: number
	timestamp: string
	action: string
	status: string
	principalId?: string | null
	organizationId?: string | null
	targetResourceType?: string | null
	targetResourceId?: string | null
	outcomeDescription?: string | null
	practitionerId?: string | null
	licenseNumber?: string | null
	jurisdiction?: string | null
	oldStatus?: string | null
	newStatus?: string | null
	oldRole?: string | null
	newRole?: string | null
	verificationProvider?: string | null
	apiResponse?: any
	ocrConfidence?: string | null
	reviewedBy?: string | null
	reason?: string | null
	ipAddress?: string | null
	userAgent?: string | null
	sessionId?: string | null
	hash?: string | null
	details?: any
}

/**
 * Compliance report summary statistics
 */
export interface ComplianceReportSummary {
	totalRecords: number
	dateRange: {
		start: string
		end: string
	}
	actionBreakdown: Record<string, number>
	statusBreakdown: Record<string, number>
	practitionerCount: number
	organizationCount: number
	verificationProviders: string[]
}

/**
 * Export format options
 */
export type ExportFormat = 'json' | 'csv'

/**
 * Compliance reporting service for practitioner audit logs
 * Provides HIPAA-compliant querying and export capabilities (Requirement 7.5)
 */
export class ComplianceReportingService {
	constructor(
		private db: PostgresJsDatabase<any>,
		private auditLogTable: any
	) {}

	/**
	 * Query audit logs with filtering and pagination (Requirement 7.5)
	 */
	async queryAuditLogs(filters: AuditLogFilters = {}): Promise<AuditLogEntry[]> {
		const conditions = []

		// Date range filter
		if (filters.dateRange) {
			conditions.push(
				between(this.auditLogTable.timestamp, filters.dateRange.start, filters.dateRange.end)
			)
		}

		// Practitioner-specific filters
		if (filters.practitionerId) {
			conditions.push(eq(this.auditLogTable.practitionerId, filters.practitionerId))
		}

		if (filters.licenseNumber) {
			conditions.push(eq(this.auditLogTable.licenseNumber, filters.licenseNumber))
		}

		if (filters.actions && filters.actions.length > 0) {
			conditions.push(inArray(this.auditLogTable.action, filters.actions))
		}

		if (filters.status && filters.status.length > 0) {
			conditions.push(inArray(this.auditLogTable.status, filters.status))
		}

		if (filters.principalId) {
			conditions.push(eq(this.auditLogTable.principalId, filters.principalId))
		}

		if (filters.organizationId) {
			conditions.push(eq(this.auditLogTable.organizationId, filters.organizationId))
		}

		if (filters.jurisdiction) {
			conditions.push(eq(this.auditLogTable.jurisdiction, filters.jurisdiction))
		}

		if (filters.verificationProvider) {
			conditions.push(eq(this.auditLogTable.verificationProvider, filters.verificationProvider))
		}

		let query = this.db
			.select()
			.from(this.auditLogTable)
			.orderBy(desc(this.auditLogTable.timestamp))

		if (conditions.length > 0) {
			query = query.where(and(...conditions))
		}

		if (filters.limit) {
			query = query.limit(filters.limit)
		}

		if (filters.offset) {
			query = query.offset(filters.offset)
		}

		return await query
	}

	/**
	 * Generate compliance report summary
	 */
	async generateComplianceReportSummary(
		filters: AuditLogFilters = {}
	): Promise<ComplianceReportSummary> {
		const logs = await this.queryAuditLogs(filters)

		const actionBreakdown: Record<string, number> = {}
		const statusBreakdown: Record<string, number> = {}
		const practitioners = new Set<string>()
		const organizations = new Set<string>()
		const verificationProviders = new Set<string>()

		let earliestDate = new Date().toISOString()
		let latestDate = new Date(0).toISOString()

		for (const log of logs) {
			// Action breakdown
			actionBreakdown[log.action] = (actionBreakdown[log.action] || 0) + 1

			// Status breakdown
			statusBreakdown[log.status] = (statusBreakdown[log.status] || 0) + 1

			// Collect unique values
			if (log.practitionerId) practitioners.add(log.practitionerId)
			if (log.organizationId) organizations.add(log.organizationId)
			if (log.verificationProvider) verificationProviders.add(log.verificationProvider)

			// Track date range
			if (log.timestamp < earliestDate) earliestDate = log.timestamp
			if (log.timestamp > latestDate) latestDate = log.timestamp
		}

		return {
			totalRecords: logs.length,
			dateRange: {
				start: filters.dateRange?.start || earliestDate,
				end: filters.dateRange?.end || latestDate,
			},
			actionBreakdown,
			statusBreakdown,
			practitionerCount: practitioners.size,
			organizationCount: organizations.size,
			verificationProviders: Array.from(verificationProviders),
		}
	}

	/**
	 * Export audit logs in specified format (Requirement 7.5)
	 */
	async exportAuditLogs(filters: AuditLogFilters, format: ExportFormat): Promise<Buffer> {
		const logs = await this.queryAuditLogs(filters)

		if (format === 'json') {
			return Buffer.from(JSON.stringify(logs, null, 2))
		}

		if (format === 'csv') {
			return this.generateCSVExport(logs)
		}

		throw new Error(`Unsupported export format: ${format}`)
	}

	/**
	 * Generate CSV export of audit logs
	 */
	private generateCSVExport(logs: AuditLogEntry[]): Buffer {
		if (logs.length === 0) {
			return Buffer.from('No data to export')
		}

		// CSV headers
		const headers = [
			'id',
			'timestamp',
			'action',
			'status',
			'principalId',
			'organizationId',
			'targetResourceType',
			'targetResourceId',
			'outcomeDescription',
			'practitionerId',
			'licenseNumber',
			'jurisdiction',
			'oldStatus',
			'newStatus',
			'oldRole',
			'newRole',
			'verificationProvider',
			'ocrConfidence',
			'reviewedBy',
			'reason',
			'ipAddress',
			'userAgent',
			'sessionId',
			'hash',
		]

		const csvRows = [headers.join(',')]

		for (const log of logs) {
			const row = headers.map((header) => {
				const value = log[header as keyof AuditLogEntry]
				if (value === null || value === undefined) return ''
				if (typeof value === 'string' && value.includes(',')) {
					return `"${value.replace(/"/g, '""')}"`
				}
				return String(value)
			})
			csvRows.push(row.join(','))
		}

		return Buffer.from(csvRows.join('\n'))
	}

	/**
	 * Search audit logs by text content
	 */
	async searchAuditLogs(
		searchTerm: string,
		filters: AuditLogFilters = {}
	): Promise<AuditLogEntry[]> {
		const conditions = []

		// Text search across relevant fields
		const searchCondition = sql`(
			${this.auditLogTable.action} ILIKE ${`%${searchTerm}%`} OR
			${this.auditLogTable.outcomeDescription} ILIKE ${`%${searchTerm}%`} OR
			${this.auditLogTable.licenseNumber} ILIKE ${`%${searchTerm}%`} OR
			${this.auditLogTable.jurisdiction} ILIKE ${`%${searchTerm}%`} OR
			${this.auditLogTable.reason} ILIKE ${`%${searchTerm}%`}
		)`
		conditions.push(searchCondition)

		// Apply other filters
		if (filters.dateRange) {
			conditions.push(
				between(this.auditLogTable.timestamp, filters.dateRange.start, filters.dateRange.end)
			)
		}

		if (filters.organizationId) {
			conditions.push(eq(this.auditLogTable.organizationId, filters.organizationId))
		}

		let query = this.db
			.select()
			.from(this.auditLogTable)
			.where(and(...conditions))
			.orderBy(desc(this.auditLogTable.timestamp))

		if (filters.limit) {
			query = query.limit(filters.limit)
		}

		if (filters.offset) {
			query = query.offset(filters.offset)
		}

		return await query
	}

	/**
	 * Verify audit log integrity using cryptographic hashes (Requirement 7.4)
	 */
	async verifyAuditLogIntegrity(logId: number): Promise<{ valid: boolean; message: string }> {
		const log = await this.db
			.select()
			.from(this.auditLogTable)
			.where(eq(this.auditLogTable.id, logId))
			.limit(1)

		if (log.length === 0) {
			return { valid: false, message: 'Audit log entry not found' }
		}

		const entry = log[0]
		if (!entry.hash) {
			return { valid: false, message: 'No hash found for integrity verification' }
		}

		// Recreate hash from critical fields
		const hashData = {
			timestamp: entry.timestamp,
			action: entry.action,
			principalId: entry.principalId,
			practitionerId: entry.practitionerId,
			status: entry.status,
			oldStatus: entry.oldStatus,
			newStatus: entry.newStatus,
			oldRole: entry.oldRole,
			newRole: entry.newRole,
		}

		const computedHash = createHash('sha256').update(JSON.stringify(hashData)).digest('hex')

		if (computedHash === entry.hash) {
			return { valid: true, message: 'Audit log integrity verified' }
		} else {
			return {
				valid: false,
				message: 'Audit log integrity check failed - possible tampering detected',
			}
		}
	}

	/**
	 * Get audit statistics for a specific practitioner
	 */
	async getPractitionerAuditStats(practitionerId: string): Promise<{
		totalEvents: number
		lastActivity: string | null
		verificationAttempts: number
		statusChanges: number
		roleChanges: number
	}> {
		const logs = await this.queryAuditLogs({ practitionerId })

		const verificationAttempts = logs.filter((log) => log.action.includes('Verification')).length

		const statusChanges = logs.filter(
			(log) => log.action === 'practitionerLicenseStatusChange'
		).length

		const roleChanges = logs.filter((log) => log.action === 'practitionerRoleModification').length

		const lastActivity = logs.length > 0 ? logs[0].timestamp : null

		return {
			totalEvents: logs.length,
			lastActivity,
			verificationAttempts,
			statusChanges,
			roleChanges,
		}
	}
}

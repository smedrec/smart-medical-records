import { createHash } from 'crypto'
import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'

import { ComplianceReportingService } from '../compliance-reporting.js'

import type { PostgresJsDatabase } from 'drizzle-orm/postgres-js'

// Mock audit log table schema
const mockAuditLogTable = {
	id: { name: 'id' },
	timestamp: { name: 'timestamp' },
	action: { name: 'action' },
	status: { name: 'status' },
	principalId: { name: 'principal_id' },
	organizationId: { name: 'organization_id' },
	practitionerId: { name: 'practitioner_id' },
	licenseNumber: { name: 'license_number' },
	jurisdiction: { name: 'jurisdiction' },
	verificationProvider: { name: 'verification_provider' },
	outcomeDescription: { name: 'outcome_description' },
	reason: { name: 'reason' },
	oldStatus: { name: 'old_status' },
	newStatus: { name: 'new_status' },
	oldRole: { name: 'old_role' },
	newRole: { name: 'new_role' },
	hash: { name: 'hash' },
} as any

// Create a proper mock query builder
const createMockQueryBuilder = (returnValue: any) => ({
	from: vi.fn().mockReturnValue({
		orderBy: vi.fn().mockReturnValue({
			where: vi.fn().mockReturnValue({
				limit: vi.fn().mockReturnValue({
					offset: vi.fn().mockReturnValue(Promise.resolve(returnValue)),
				}),
			}),
		}),
		where: vi.fn().mockReturnValue({
			orderBy: vi.fn().mockReturnValue({
				limit: vi.fn().mockReturnValue({
					offset: vi.fn().mockReturnValue(Promise.resolve(returnValue)),
				}),
			}),
		}),
		limit: vi.fn().mockReturnValue({
			offset: vi.fn().mockReturnValue(Promise.resolve(returnValue)),
		}),
	}),
})

// Mock database
const mockDb = {
	select: vi.fn(),
} as unknown as PostgresJsDatabase<any>

// Mock audit log data
const mockAuditLogs = [
	{
		id: 1,
		timestamp: '2024-01-15T10:00:00Z',
		action: 'practitionerLicenseStatusChange',
		status: 'success',
		principalId: 'admin-123',
		organizationId: 'org-001',
		practitionerId: 'prac-456',
		licenseNumber: 'LIC-789',
		jurisdiction: 'CA',
		oldStatus: 'pending',
		newStatus: 'active',
		hash: 'abc123hash',
		outcomeDescription: 'License activated',
		details: null,
		targetResourceType: 'Practitioner',
		targetResourceId: 'prac-456',
		verificationProvider: null,
		apiResponse: null,
		ocrConfidence: null,
		reviewedBy: null,
		reason: 'Verification completed',
		ipAddress: '192.168.1.1',
		userAgent: 'Mozilla/5.0',
		sessionId: 'sess-123',
		ttl: null,
	},
	{
		id: 2,
		timestamp: '2024-01-16T11:00:00Z',
		action: 'practitionerRoleModification',
		status: 'success',
		principalId: 'admin-123',
		organizationId: 'org-001',
		practitionerId: 'prac-456',
		licenseNumber: null,
		jurisdiction: null,
		oldStatus: null,
		newStatus: null,
		oldRole: 'Practitioner',
		newRole: 'Owner',
		hash: 'def456hash',
		outcomeDescription: 'Role updated',
		details: null,
		targetResourceType: 'Practitioner',
		targetResourceId: 'prac-456',
		verificationProvider: null,
		apiResponse: null,
		ocrConfidence: null,
		reviewedBy: 'admin-123',
		reason: 'Promotion approved',
		ipAddress: '192.168.1.1',
		userAgent: 'Mozilla/5.0',
		sessionId: 'sess-124',
		ttl: null,
	},
	{
		id: 3,
		timestamp: '2024-01-17T12:00:00Z',
		action: 'practitionerLicenseVerificationSuccess',
		status: 'success',
		principalId: 'system',
		organizationId: 'org-002',
		practitionerId: 'prac-789',
		licenseNumber: 'LIC-101',
		jurisdiction: 'NY',
		oldStatus: null,
		newStatus: null,
		oldRole: null,
		newRole: null,
		verificationProvider: 'NPI Registry',
		hash: 'ghi789hash',
		outcomeDescription: 'License verified',
		details: null,
		targetResourceType: 'Practitioner',
		targetResourceId: 'prac-789',
		apiResponse: { verified: true, status: 'active' },
		ocrConfidence: null,
		reviewedBy: null,
		reason: null,
		ipAddress: null,
		userAgent: null,
		sessionId: null,
		ttl: null,
	},
]

describe('ComplianceReportingService', () => {
	let reportingService: ComplianceReportingService

	beforeEach(() => {
		vi.clearAllMocks()
		reportingService = new ComplianceReportingService(mockDb, mockAuditLogTable)

		// Setup mock query chain that returns mockAuditLogs
		const mockQueryChain = Promise.resolve(mockAuditLogs)
		mockDb.select = vi.fn().mockReturnValue({
			from: vi.fn().mockReturnValue({
				orderBy: vi.fn().mockReturnValue(mockQueryChain),
				where: vi.fn().mockReturnValue({
					orderBy: vi.fn().mockReturnValue({
						limit: vi.fn().mockReturnValue({
							offset: vi.fn().mockReturnValue(mockQueryChain),
						}),
					}),
				}),
				limit: vi.fn().mockReturnValue({
					offset: vi.fn().mockReturnValue(mockQueryChain),
				}),
			}),
		})
	})

	afterEach(() => {
		vi.restoreAllMocks()
	})

	describe('queryAuditLogs', () => {
		it('should query audit logs without filters', async () => {
			const result = await reportingService.queryAuditLogs()
			expect(result).toEqual(mockAuditLogs)
		})

		it('should apply date range filter', async () => {
			const filters = {
				dateRange: {
					start: '2024-01-01T00:00:00Z',
					end: '2024-01-31T23:59:59Z',
				},
			}

			await reportingService.queryAuditLogs(filters)

			// Verify that the query builder methods were called
			expect(mockDb.select).toHaveBeenCalled()
		})

		it('should apply practitioner filter', async () => {
			const filters = {
				practitionerId: 'prac-456',
			}

			await reportingService.queryAuditLogs(filters)
			expect(mockDb.select).toHaveBeenCalled()
		})

		it('should apply multiple filters', async () => {
			const filters = {
				practitionerId: 'prac-456',
				organizationId: 'org-001',
				actions: ['practitionerLicenseStatusChange' as const],
				status: ['success' as const],
				limit: 10,
				offset: 0,
			}

			await reportingService.queryAuditLogs(filters)
			expect(mockDb.select).toHaveBeenCalled()
		})
	})

	describe('generateComplianceReportSummary', () => {
		it('should generate summary statistics', async () => {
			const summary = await reportingService.generateComplianceReportSummary()

			expect(summary).toEqual({
				totalRecords: 3,
				dateRange: {
					start: '2024-01-15T10:00:00Z',
					end: '2024-01-17T12:00:00Z',
				},
				actionBreakdown: {
					practitionerLicenseStatusChange: 1,
					practitionerRoleModification: 1,
					practitionerLicenseVerificationSuccess: 1,
				},
				statusBreakdown: {
					success: 3,
				},
				practitionerCount: 2,
				organizationCount: 2,
				verificationProviders: ['NPI Registry'],
			})
		})

		it('should handle empty results', async () => {
			// Mock empty results
			const emptyQuery = {
				then: vi.fn().mockResolvedValue([]),
			}
			mockDb.select = vi.fn().mockReturnValue({
				from: vi.fn().mockReturnValue({
					orderBy: vi.fn().mockReturnValue({
						where: vi.fn().mockReturnValue({
							limit: vi.fn().mockReturnValue({
								offset: vi.fn().mockReturnValue(emptyQuery),
							}),
						}),
					}),
				}),
			})

			const summary = await reportingService.generateComplianceReportSummary()

			expect(summary.totalRecords).toBe(0)
			expect(summary.practitionerCount).toBe(0)
			expect(summary.organizationCount).toBe(0)
		})
	})

	describe('exportAuditLogs', () => {
		it('should export logs as JSON', async () => {
			const filters = { limit: 10 }
			const result = await reportingService.exportAuditLogs(filters, 'json')

			expect(result).toBeInstanceOf(Buffer)
			const jsonData = JSON.parse(result.toString())
			expect(jsonData).toEqual(mockAuditLogs)
		})

		it('should export logs as CSV', async () => {
			const filters = { limit: 10 }
			const result = await reportingService.exportAuditLogs(filters, 'csv')

			expect(result).toBeInstanceOf(Buffer)
			const csvData = result.toString()

			// Check CSV headers
			expect(csvData).toContain('id,timestamp,action,status')
			expect(csvData).toContain('practitionerId,licenseNumber,jurisdiction')

			// Check data rows
			expect(csvData).toContain('1,2024-01-15T10:00:00Z,practitionerLicenseStatusChange,success')
			expect(csvData).toContain('prac-456,LIC-789,CA')
		})

		it('should handle empty export', async () => {
			// Mock empty results
			const emptyQuery = {
				then: vi.fn().mockResolvedValue([]),
			}
			mockDb.select = vi.fn().mockReturnValue({
				from: vi.fn().mockReturnValue({
					orderBy: vi.fn().mockReturnValue({
						where: vi.fn().mockReturnValue({
							limit: vi.fn().mockReturnValue({
								offset: vi.fn().mockReturnValue(emptyQuery),
							}),
						}),
					}),
				}),
			})

			const result = await reportingService.exportAuditLogs({}, 'csv')
			expect(result.toString()).toBe('No data to export')
		})

		it('should throw error for unsupported format', async () => {
			await expect(reportingService.exportAuditLogs({}, 'xml' as any)).rejects.toThrow(
				'Unsupported export format: xml'
			)
		})
	})

	describe('searchAuditLogs', () => {
		it('should search audit logs by text', async () => {
			const searchTerm = 'license'
			await reportingService.searchAuditLogs(searchTerm)

			expect(mockDb.select).toHaveBeenCalled()
		})

		it('should search with additional filters', async () => {
			const searchTerm = 'verification'
			const filters = {
				organizationId: 'org-001',
				limit: 5,
			}

			await reportingService.searchAuditLogs(searchTerm, filters)
			expect(mockDb.select).toHaveBeenCalled()
		})
	})

	describe('verifyAuditLogIntegrity', () => {
		it('should verify valid audit log integrity', async () => {
			const mockLog = {
				id: 1,
				timestamp: '2024-01-15T10:00:00Z',
				action: 'practitionerLicenseStatusChange',
				principalId: 'admin-123',
				practitionerId: 'prac-456',
				status: 'success',
				oldStatus: 'pending',
				newStatus: 'active',
				oldRole: null,
				newRole: null,
				hash: '',
			}

			// Generate correct hash
			const hashData = {
				timestamp: mockLog.timestamp,
				action: mockLog.action,
				principalId: mockLog.principalId,
				practitionerId: mockLog.practitionerId,
				status: mockLog.status,
				oldStatus: mockLog.oldStatus,
				newStatus: mockLog.newStatus,
				oldRole: mockLog.oldRole,
				newRole: mockLog.newRole,
			}
			mockLog.hash = createHash('sha256').update(JSON.stringify(hashData)).digest('hex')

			// Mock database query
			const mockQuery = {
				then: vi.fn().mockResolvedValue([mockLog]),
			}
			mockDb.select = vi.fn().mockReturnValue({
				from: vi.fn().mockReturnValue({
					where: vi.fn().mockReturnValue({
						limit: vi.fn().mockReturnValue(mockQuery),
					}),
				}),
			})

			const result = await reportingService.verifyAuditLogIntegrity(1)

			expect(result.valid).toBe(true)
			expect(result.message).toBe('Audit log integrity verified')
		})

		it('should detect tampered audit log', async () => {
			const mockLog = {
				id: 1,
				timestamp: '2024-01-15T10:00:00Z',
				action: 'practitionerLicenseStatusChange',
				principalId: 'admin-123',
				practitionerId: 'prac-456',
				status: 'success',
				oldStatus: 'pending',
				newStatus: 'active',
				oldRole: null,
				newRole: null,
				hash: 'invalid-hash',
			}

			// Mock database query
			const mockQuery = {
				then: vi.fn().mockResolvedValue([mockLog]),
			}
			mockDb.select = vi.fn().mockReturnValue({
				from: vi.fn().mockReturnValue({
					where: vi.fn().mockReturnValue({
						limit: vi.fn().mockReturnValue(mockQuery),
					}),
				}),
			})

			const result = await reportingService.verifyAuditLogIntegrity(1)

			expect(result.valid).toBe(false)
			expect(result.message).toBe('Audit log integrity check failed - possible tampering detected')
		})

		it('should handle missing audit log', async () => {
			// Mock empty query result
			const mockQuery = {
				then: vi.fn().mockResolvedValue([]),
			}
			mockDb.select = vi.fn().mockReturnValue({
				from: vi.fn().mockReturnValue({
					where: vi.fn().mockReturnValue({
						limit: vi.fn().mockReturnValue(mockQuery),
					}),
				}),
			})

			const result = await reportingService.verifyAuditLogIntegrity(999)

			expect(result.valid).toBe(false)
			expect(result.message).toBe('Audit log entry not found')
		})

		it('should handle missing hash', async () => {
			const mockLog = {
				id: 1,
				hash: null,
			}

			// Mock database query
			const mockQuery = {
				then: vi.fn().mockResolvedValue([mockLog]),
			}
			mockDb.select = vi.fn().mockReturnValue({
				from: vi.fn().mockReturnValue({
					where: vi.fn().mockReturnValue({
						limit: vi.fn().mockReturnValue(mockQuery),
					}),
				}),
			})

			const result = await reportingService.verifyAuditLogIntegrity(1)

			expect(result.valid).toBe(false)
			expect(result.message).toBe('No hash found for integrity verification')
		})
	})

	describe('getPractitionerAuditStats', () => {
		it('should calculate practitioner statistics', async () => {
			const practitionerLogs = [
				{
					...mockAuditLogs[0],
					action: 'practitionerLicenseStatusChange',
				},
				{
					...mockAuditLogs[1],
					action: 'practitionerRoleModification',
				},
				{
					...mockAuditLogs[2],
					action: 'practitionerLicenseVerificationSuccess',
				},
			]

			// Mock query for specific practitioner
			const mockQuery = {
				then: vi.fn().mockResolvedValue(practitionerLogs),
			}
			mockDb.select = vi.fn().mockReturnValue({
				from: vi.fn().mockReturnValue({
					orderBy: vi.fn().mockReturnValue({
						where: vi.fn().mockReturnValue({
							limit: vi.fn().mockReturnValue({
								offset: vi.fn().mockReturnValue(mockQuery),
							}),
						}),
					}),
				}),
			})

			const stats = await reportingService.getPractitionerAuditStats('prac-456')

			expect(stats).toEqual({
				totalEvents: 3,
				lastActivity: '2024-01-15T10:00:00Z',
				verificationAttempts: 1,
				statusChanges: 1,
				roleChanges: 1,
			})
		})

		it('should handle practitioner with no events', async () => {
			// Mock empty query result
			const mockQuery = {
				then: vi.fn().mockResolvedValue([]),
			}
			mockDb.select = vi.fn().mockReturnValue({
				from: vi.fn().mockReturnValue({
					orderBy: vi.fn().mockReturnValue({
						where: vi.fn().mockReturnValue({
							limit: vi.fn().mockReturnValue({
								offset: vi.fn().mockReturnValue(mockQuery),
							}),
						}),
					}),
				}),
			})

			const stats = await reportingService.getPractitionerAuditStats('prac-999')

			expect(stats).toEqual({
				totalEvents: 0,
				lastActivity: null,
				verificationAttempts: 0,
				statusChanges: 0,
				roleChanges: 0,
			})
		})
	})
})

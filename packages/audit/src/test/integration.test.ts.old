import { createHash } from 'crypto'
import { describe, expect, it } from 'vitest'

import { ComplianceReportingService } from '../compliance-reporting.js'
import { PractitionerAuditService } from '../practitioner-audit.js'

describe('Practitioner Audit Integration', () => {
	describe('PractitionerAuditService', () => {
		it('should create practitioner audit service instance', () => {
			expect(() => new PractitionerAuditService('test-queue')).not.toThrow()
		})

		it('should generate consistent hashes', () => {
			const hashData = {
				timestamp: '2024-01-15T10:00:00Z',
				action: 'practitionerLicenseStatusChange',
				principalId: 'admin-123',
				practitionerId: 'prac-456',
				status: 'success',
				oldStatus: 'pending',
				newStatus: 'active',
				oldRole: null,
				newRole: null,
			}

			const hash1 = createHash('sha256').update(JSON.stringify(hashData)).digest('hex')
			const hash2 = createHash('sha256').update(JSON.stringify(hashData)).digest('hex')

			expect(hash1).toBe(hash2)
			expect(hash1).toHaveLength(64) // SHA-256 hex string length
		})
	})

	describe('ComplianceReportingService', () => {
		it('should create compliance reporting service instance', () => {
			const mockDb = {} as any
			const mockTable = {} as any

			expect(() => new ComplianceReportingService(mockDb, mockTable)).not.toThrow()
		})

		it('should generate CSV export correctly', () => {
			const mockDb = {} as any
			const mockTable = {} as any
			const service = new ComplianceReportingService(mockDb, mockTable)

			// Test CSV generation with empty data
			const emptyResult = (service as any).generateCSVExport([])
			expect(emptyResult.toString()).toBe('No data to export')

			// Test CSV generation with sample data
			const sampleData = [
				{
					id: 1,
					timestamp: '2024-01-15T10:00:00Z',
					action: 'practitionerLicenseStatusChange',
					status: 'success',
					practitionerId: 'prac-456',
					licenseNumber: 'LIC-789',
					jurisdiction: 'CA',
					hash: 'abc123',
				},
			]

			const csvResult = (service as any).generateCSVExport(sampleData)
			const csvString = csvResult.toString()

			expect(csvString).toContain('id,timestamp,action,status')
			expect(csvString).toContain('1,2024-01-15T10:00:00Z,practitionerLicenseStatusChange,success')
		})
	})

	describe('Type Definitions', () => {
		it('should have correct practitioner audit action types', () => {
			const actions = [
				'practitionerLicenseStatusChange',
				'practitionerRoleModification',
				'practitionerLicenseVerificationAttempt',
				'practitionerLicenseVerificationSuccess',
				'practitionerLicenseVerificationFailure',
				'practitionerOnboardingInitiated',
				'practitionerApprovalGranted',
				'practitionerApprovalRejected',
				'practitionerCertificateUploaded',
				'practitionerOCRProcessing',
				'practitionerManualReview',
				'practitionerComplianceExport',
			]

			// This test ensures our type definitions are comprehensive
			expect(actions).toHaveLength(12)
			expect(actions).toContain('practitionerLicenseStatusChange')
			expect(actions).toContain('practitionerComplianceExport')
		})
	})
})
